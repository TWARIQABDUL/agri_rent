rules_version = '2';

// AgriRent Firestore security rules.
//
// The Flutter client holds no secrets, so every write it sends is treated as
// attacker-controlled. These rules re-check three things on the server for each
// request: who is asking, whether they own the record, and whether the payload
// has a legal shape. Anything derived (ratings, booking counts, payout flags,
// KYC verification) is closed to clients entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- identity

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // One get() per request, reused by the predicates below.
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Listing writes are gated on KYC: an account is only an owner in the eyes
    // of these rules once an administrator has set `verified` to true.
    function isVerifiedOwner() {
      return hasProfile() && profile().role == 'owner' && profile().verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function walletAfter(uid) {
      return getAfter(
        /databases/$(database)/documents/wallets/$(uid)
      ).data;
    }

    function walletActivityAfter(uid, transactionId) {
      return getAfter(
        /databases/$(database)/documents/wallets/$(uid)/transactions/$(transactionId)
      ).data;
    }

    function validPaidRental(rentalId) {
      return incoming().paymentStatus == 'paid'
        && incoming().walletTransactionId is string
        && incoming().walletTransactionId.size() > 0
        && walletAfter(incoming().renterId).lastTransactionId
          == incoming().walletTransactionId
        && walletActivityAfter(
          incoming().renterId,
          incoming().walletTransactionId
        ).type == 'rentalPayment'
        && walletActivityAfter(
          incoming().renterId,
          incoming().walletTransactionId
        ).rentalId == rentalId
        && walletActivityAfter(
          incoming().renterId,
          incoming().walletTransactionId
        ).amount == -incoming().totalAmount
        && walletActivityAfter(
          incoming().renterId,
          incoming().walletTransactionId
        ).balanceAfter == walletAfter(incoming().renterId).balance;
    }

    // ------------------------------------------------------------------- users

    match /users/{uid} {
      allow read: if isSelf(uid);

      // A client may create its own profile and declare a role, but never
      // arrive already verified.
      allow create: if isSelf(uid)
        && incoming().role in ['owner', 'farmer']
        && incoming().verified == false
        && incoming().createdAt == request.time;

      // Two allowed shapes:
      //   1. Regular profile updates — role, name, contact fields. `verified`
      //      is deliberately out of this set, so an ordinary update touching
      //      it is rejected.
      //   2. Self-promotion to KYC-verified — only when the auth token itself
      //      certifies the email is verified (request.auth.token.email_verified).
      //      The token claim is set by Firebase, not by the client, so the
      //      client can't lie its way to owner powers.
      allow update: if isSelf(uid)
        && incoming().role in ['owner', 'farmer']
        && (
          changedKeys().hasOnly([
            'role', 'displayName', 'email', 'phone', 'district', 'updatedAt'
          ])
          ||
          (
            changedKeys().hasOnly(['verified', 'updatedAt'])
            && request.auth.token.email_verified == true
            && incoming().verified == true
          )
        );

      allow delete: if false;

      match /favorites/{equipmentId} {
        allow read: if isSelf(uid);

        allow create: if isSelf(uid)
          && incoming().userId == uid
          && incoming().equipmentId == equipmentId
          && incoming().createdAt == request.time;

        allow update: if false;
        allow delete: if isSelf(uid);
      }
    }

    // --------------------------------------------------------------- equipment

    function validCategory(category) {
      return category in ['Tractors', 'Pumps', 'Sprayers', 'Harvesters'];
    }

    // Shape and range checks run on create and on update. An update that sets
    // pricePerDay to a string, to zero, or to a negative number is as invalid
    // as a create that does.
    function validListing() {
      return incoming().name is string
        && incoming().name.size() >= 3
        && incoming().name.size() <= 80
        && validCategory(incoming().category)
        && incoming().description is string
        && incoming().description.size() >= 20
        && incoming().description.size() <= 1000
        && incoming().pricePerDay is number
        && incoming().pricePerDay > 0
        && incoming().pricePerDay <= 10000000
        && incoming().pricePerMonth is number
        && incoming().pricePerMonth >= 0
        && incoming().location is string
        && incoming().location.size() >= 2
        && incoming().location.size() <= 120
        && incoming().image is string
        && incoming().image.size() <= 500
        && incoming().status in ['available', 'paused'];
    }

    match /equipment/{listingId} {
      // Browsing is open to any signed-in user; the catalogue is the product.
      allow read: if isSignedIn();

      allow create: if isVerifiedOwner()
        && incoming().ownerId == request.auth.uid
        && validListing()
        && incoming().status == 'available'
        && incoming().rating == 0
        && incoming().bookingCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Editing and pausing share this rule. `ownerId`, `createdAt`, `rating`
      // and `bookingCount` are outside the allowed key set, which is what stops
      // an owner reassigning a listing or inflating its reputation.
      allow update: if isVerifiedOwner()
        && resource.data.ownerId == request.auth.uid
        && validListing()
        && incoming().updatedAt == request.time
        && changedKeys().hasOnly([
          'name', 'category', 'description', 'pricePerDay', 'pricePerMonth',
          'location', 'image', 'status', 'updatedAt'
        ]);

      // Listings are paused, never deleted, so rental history stays intact.
      allow delete: if false;
    }

    // ---------------------------------------------------------------- wallets

    match /wallets/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && incoming().userId == uid
        && incoming().balance == 0
        && incoming().currency == 'RWF'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Every balance mutation must be part of the same atomic write as its
      // immutable ledger record. Checkout additionally links that ledger entry
      // to the new rental in validPaidRental().
      allow update: if isSelf(uid)
        && incoming().userId == resource.data.userId
        && incoming().currency == resource.data.currency
        && incoming().balance is number
        && incoming().balance >= 0
        && incoming().lastTransactionId is string
        && incoming().updatedAt == request.time
        && changedKeys().hasOnly([
          'balance', 'lastTransactionId', 'updatedAt'
        ])
        && walletActivityAfter(uid, incoming().lastTransactionId).userId == uid
        && walletActivityAfter(uid, incoming().lastTransactionId).amount is number
        && walletActivityAfter(uid, incoming().lastTransactionId).amount != 0
        && walletActivityAfter(uid, incoming().lastTransactionId).balanceAfter
          == incoming().balance
        && incoming().balance == resource.data.balance
          + walletActivityAfter(uid, incoming().lastTransactionId).amount;

      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if isSelf(uid);

        allow create: if isSelf(uid)
          && incoming().userId == uid
          && incoming().type in ['topUp', 'rentalPayment']
          && incoming().amount is number
          && incoming().amount != 0
          && incoming().balanceAfter is number
          && incoming().balanceAfter >= 0
          && incoming().title is string
          && incoming().createdAt == request.time
          && walletAfter(uid).lastTransactionId == transactionId
          && walletAfter(uid).balance == incoming().balanceAfter;

        allow update, delete: if false;
      }
    }

    // ----------------------------------------------------------------- rentals

    match /rentals/{rentalId} {
      allow read: if isSignedIn()
        && (resource.data.renterId == request.auth.uid
          || resource.data.ownerId == request.auth.uid);

      // A farmer opens a request against a listing; money and payout state are
      // fixed by the server-side shape, not chosen by the client.
      allow create: if isSignedIn()
        && incoming().renterId == request.auth.uid
        && incoming().ownerId is string
        && incoming().equipmentId is string
        && incoming().status == 'pending'
        && incoming().paidOut == false
        && validPaidRental(rentalId)
        && incoming().totalAmount is number
        && incoming().totalAmount > 0
        && incoming().startDate is timestamp
        && incoming().endDate is timestamp
        && incoming().endDate >= incoming().startDate
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // The owner answers and advances the rental; the renter may only walk
      // away from a request nobody has answered yet. Neither side can touch
      // `paidOut` or `totalAmount`.
      allow update: if isSignedIn()
        && changedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().updatedAt == request.time
        && (
          (resource.data.ownerId == request.auth.uid
            && incoming().status in ['accepted', 'declined', 'active', 'completed'])
          ||
          (resource.data.renterId == request.auth.uid
            && resource.data.status == 'pending'
            && incoming().status == 'cancelled')
        );

      allow delete: if isSignedIn()
        && resource.data.renterId == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
